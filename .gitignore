# Dataset images are not committed (hundreds of JPEGs), but manifest.json IS:
# it records the sha256, split and capture timestamp of every image, which is
# what makes a trained model traceable to its exact inputs.
#
# Note the pattern: it must exclude the directory's CONTENTS (dataset/*), not
# the directory itself (dataset/). Git does not descend into an excluded
# directory, so a "!dataset/manifest.json" negation under a "dataset/" rule
# never takes effect.
classifier/dataset/*
!classifier/dataset/manifest.json
best_model.keras
debug_frame.jpg
__pycache__/
*.pyc
classifier/firmware/build/
classifier/firmware/main/build/

# Generated by eval_model.py --dump-misses
classifier/misclassified_*/
